#!/usr/bin/env bash

# User entry generator for conf/users.json
# Usage: ./passwd_hash <login> <credential>
#
# Prints one user entry { "id", "login", "hash" } for conf/users.json. The id is a
# fresh random UUID: boards record it as their owner, so it must never change once
# the user owns boards. The hash is scrypt (format salt:hash, both hex-encoded),
# which is resistant to rainbow table and brute-force attacks.

if [ $# -ne 2 ]; then
    echo "Usage: $0 <login> <credential>"
    echo ""
    echo "Prints a user entry with a new id and the scrypt hash of the credential."
    exit 1
fi

# Login and credential reach node through the environment, never as code. The hash
# comes from users.js, the same code the server checks credentials with.
USERS_JS="$(cd "$(dirname "$0")" && pwd)/users.js"
LOGIN="$1" CREDENTIAL="$2" USERS_JS="$USERS_JS" node -e "
const crypto = require('crypto');
const { hashPassword } = require(process.env.USERS_JS);
const entry = { id: crypto.randomUUID(), login: process.env.LOGIN, hash: hashPassword(process.env.CREDENTIAL) };
console.log(JSON.stringify(entry, null, 2));
" || exit 1

echo ""
echo "Add the entry above to the list in conf/users.json:"
echo '[ { "id": ..., "login": ..., "hash": ... }, ... ]'
echo "To change a credential, keep the id and replace only the hash."
